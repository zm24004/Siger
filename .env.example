# =============================================================================
# SIGER — Variables de entorno de ejemplo
# =============================================================================
# Copia este archivo a .env (raíz del repo) o exporta las variables en tu shell.
# NUNCA commitees un .env con secretos reales. .gitignore ya excluye .env.
#
#   cp .env.example .env
#   # edita .env con valores reales
#
# Docker Compose lee automáticamente el archivo .env de la raíz del proyecto.
# =============================================================================

# --- MySQL ---
MYSQL_DATABASE=siger
MYSQL_USER=siger_app
MYSQL_PASSWORD=cambia_esta_password_por_una_segura
MYSQL_ROOT_PASSWORD=cambia_esta_root_password_por_una_segura
MYSQL_PORT=3306

# --- Backend (Spring Boot) ---
# URL JDBC inyectada por docker-compose. En arranque local sin docker usar:
#   jdbc:mysql://localhost:3306/siger?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://db:3306/siger?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=false
DB_USERNAME=siger_app
DB_PASSWORD=cambia_esta_password_por_una_segura
DB_DRIVER=com.mysql.cj.jdbc.Driver
JWT_SECRET=genera_un_secret_largo_y_aleatorio_de_al_menos_64_caracteres_aqui
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Frontend (Vite) ---
# Vite expone variables prefijadas con VITE_ al navegador
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=SIGER

# --- Puerto público del frontend en Docker ---
FRONTEND_PORT=5173
